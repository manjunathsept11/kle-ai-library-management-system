# Copy to .env and fill in. NEVER commit a real .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
INSTITUTION_NAME=KLE Institute

# --- Database --------------------------------------------------------------
# Local development: SQLite, no install required.
DATABASE_URL=sqlite:///./var/library.db
# Production: point at PostgreSQL and add psycopg to requirements, e.g.
# DATABASE_URL=postgresql+psycopg://library:library@localhost:5432/library

# --- Auth ---------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS -------------------------------------------------------------
CORS_ORIGINS=http://localhost:5180,http://localhost:3000

# --- AI providers ---------------------------------------------------------
# AI is optional. With everything on "mock" the system runs fully offline;
# semantic search falls back to keyword search and the chatbot returns a
# clear "AI unavailable" message.
AI_ENABLED=true
LLM_PROVIDER=mock          # openai | anthropic | local | mock
EMBEDDING_PROVIDER=mock    # openai | local | mock

LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
CHAT_RATE_LIMIT_PER_HOUR=60

EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Email (notifications) ---------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=library@kle.edu

# --- Frontend -----------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
